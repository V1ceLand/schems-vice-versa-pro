# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в репозиторий не попадает (см. .gitignore).

DB_NAME=my_db_name
DB_USER=user
DB_PASS=change_me
DB_CHARSET=utf8mb4

# Токен Telegram-бота (получить у @BotFather)
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# Google OAuth Client ID (console.cloud.google.com -> Credentials)
GOOGLE_CLIENT_ID=
